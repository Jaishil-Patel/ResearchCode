<?xml version="1.0"?>
<!-- GENERATED by tools/gen_world.py for room 'final_scan' on 2026-10-01 10:54:59.
     Do not edit. Both branch worlds come from one template so that the geometry source
     is the only difference between them (proposal S4.4.2); an edit here would apply to
     one branch only and silently break that. Change the template instead. -->
<sdf version="1.9">
  <world name="room_standard">

    <!-- Physics -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics">
      <engine>
        <filename>ignition-physics-dartsim-plugin</filename>
      </engine>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </plugin>
    <physics name="physics_config" type="dart">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene -->
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <scene>
      <ambient>0.8 0.8 0.8</ambient>
      <grid>false</grid>
    </scene>

    <!-- User Commands (transform control) -->
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <!-- Sensors (rendering-based: camera, depth camera, gpu_lidar).

         WSL2, measured 2026-07-31 -- applies to every rendered sensor:
           ogre2 + hardware GL              -> server aborts in GL3PlusTextureGpu::copyTo
           ogre  + hardware GL              -> runs, every lidar beam pinned at <min>,
                                               no error logged. This is the dangerous one.
           ogre2 + LIBGL_ALWAYS_SOFTWARE=1  -> correct, within ~2 mm of ground truth
         So: export LIBGL_ALWAYS_SOFTWARE=1 before launching, and re-run
         tools/verify_sensors.sh after any change to the render setup. -->
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU (not driven by the Sensors system; needs its own) -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu">
    </plugin>

    <!-- Contact (not driven by the Sensors system either; the base contact sensor of
         proposal S4.4.1/4.4.3 needs it). This is the collision ground truth for C_i in
         Eq. 4.1 and CR in Eq. 4.5 -- it lives in the template rather than in one
         generated world for exactly the reason the comment above this block gives: adding
         it to one branch only would make gen_world.py --check fail, correctly, and would
         leave the two branches differing in more than the geometry S4.4.2 requires. -->
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact">
    </plugin>

    <!-- Illumination.
         Identical in both branches. The photogrammetric mesh carries baked-in lighting
         from the capture; the standard branch does not. That asymmetry is inherent to
         the comparison and is not something the world file should try to compensate
         for -- doing so would introduce a second difference between the branches. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <!-- The room. THIS LINE IS THE EXPERIMENT'S INDEPENDENT VARIABLE. -->
    <include>
      <uri>model://room_standard</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
