From b5d26ae85a6090e03378dd5472de981ef68defcd Mon Sep 17 00:00:00 2001
From: Jaishil-Patel <jaishilpatel1105@gmail.com>
Date: Wed, 7 Oct 2026 11:44:06 +0200
Subject: [PATCH 7/7] Pitch the head down for navigation: HeadPitch 0.45, not
 StandInit's -0.204

-0.204 looks ~12 deg up (positive HeadPitch looks down). With the 45-deg vertical field of
view the bottom of the depth image sat ~11 deg below horizontal, so the floor never appeared
and a 0.5 m object was invisible nearer than ~3.3 m; in a smoke run Pepper hit a bag while
her nearest depth return was 1.5-1.9 m away. At 0.45 the floor is in view from ~1 m and the
bag reads 0.79 m at 0.7 m. The real robot is posed to the same value by the main repo's
tools/naoqi_shim.py SIM_HEAD_PITCH.
---
 .../config/initial_joint_positions.yaml                    | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/pepper_robot_description/config/initial_joint_positions.yaml b/pepper_robot_description/config/initial_joint_positions.yaml
index 73294ff..1500cf3 100644
--- a/pepper_robot_description/config/initial_joint_positions.yaml
+++ b/pepper_robot_description/config/initial_joint_positions.yaml
@@ -2,8 +2,13 @@
 # docs/calib_20261002_0948/standing_angles.txt. The old values had RElbowRoll 0.17 (real 0.511,
 # mirror of LElbowRoll -0.511) and both ShoulderPitch 1.77 (real 1.575/1.583). HeadYaw is 0 (real
 # 0.009). Hands and fingers were not measured and keep their previous values.
+#
+# HeadPitch is NOT the StandInit value (-0.204, ~12 deg up, for facing people). It is pitched
+# down for navigation (positive = down): at -0.204 the depth camera never saw the floor or any
+# low obstacle within ~3 m (found 7 Oct 2026). The real robot is posed to the same value by
+# tools/naoqi_shim.py SIM_HEAD_PITCH, and the two must stay equal.
 initial_joint_positions:
-  HeadPitch: -0.204
+  HeadPitch: 0.45
   HeadYaw: 0.0
   LElbowRoll: -0.511
   LElbowYaw: -1.246
-- 
2.34.1

