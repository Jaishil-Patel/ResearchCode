diff --git a/pepper_robot_description/urdf/pepper_drive_wheels.xacro b/pepper_robot_description/urdf/pepper_drive_wheels.xacro
new file mode 100644
index 0000000..a7df1d4
--- /dev/null
+++ b/pepper_robot_description/urdf/pepper_drive_wheels.xacro
@@ -0,0 +1,61 @@
+<?xml version="1.0"?>
+<!-- Simulation-only drivetrain: two virtual coaxial drive wheels under the wheel base.
+
+     Pepper's three real wheels are omni wheels 120 degrees apart. Fortress has no omni-wheel
+     model, and DiffDrive on two of them made them fight (the axles are ~62 degrees apart) while
+     the third dragged: measured 30 Sep 2026, a forward command moved her 0.2 m BACKWARDS and left
+     her leaning 22 degrees; random commands tipped her past 40 degrees.
+
+     Here the three real wheels stay as frictionless supports (gazebo_misc_references), so the
+     support polygon is the real robot's, and these two wheels, on one axle along y at the base
+     centre and 0.31 m apart, carry the traction. DiffDrive drives them exactly as it expects.
+     Gravity and friction act normally. The radius is 2 mm larger than the real wheels
+     (0.072 vs 0.07) so they carry load to grip.
+
+     Measured 30 Sep 2026 on room_standard (clear course, sim-time fits): straight 0.3 m/s 82%,
+     spins 96-116%, arcs ~40-80%, max tilt 9 deg, no falls. Alternatives tried and rejected:
+       * VelocityControl (torso or wheel base): tipped over; it overwrites link velocity in the
+         link frame, so pitch becomes a climb gravity cannot correct.
+       * r=0.076, mu 2.0: straight 99% but turning ~50%, arcs 8-60%.
+       * drive wheels + two centreline casters: straight 99-101%, but the narrower support
+         polygon tipped her in gentle arcs.
+       * (1 Oct 2026) sprung drive wheels, to keep traction on the photogrammetric floor, where
+         this rigid axle hangs in the air over dips > 2 mm (~8% of poses; most smoke-test
+         timeouts there were Pepper stuck at such a spot). A prismatic DriveSusp joint between
+         Tibia and each wheel broke driving outright, even on the flat standard floor: the
+         light wheel link sank 9-18 mm into the floor (DART corrects penetration and limit
+         violation on it only ~2 mm/s), the wheels spun with no grip, and 0.2 m/s moved her
+         1 cm in 4 s. <springStiffness> is carried into the SDF but not applied to the joint;
+         a JointPositionController spring, a sphere wheel, heavier unsprung mass and the
+         support wheels' kp/kd/min_depth all failed the same way. A tripod (drive axle + back
+         wheel, front wheels raised as tip guards) was ruled out: the CoM is only 9 mm behind
+         the axle. Rigid axle kept; the uneven-floor problem is handled on the floor side.
+     Remaining tracking error is to be measured against the real robot (tools/base_sysid.py)
+     and reported, not hidden.
+     Collision only, no visual: the depth camera must not see them. -->
+<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
+  <xacro:macro name="virtual_drive_wheel" params="side y">
+    <link name="Drive${side}_link">
+      <inertial>
+        <mass value="0.2" />
+        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0003" />
+        <origin rpy="0 0 0" xyz="0 0 0" />
+      </inertial>
+      <collision>
+        <origin rpy="1.5707963 0 0" xyz="0 0 0" />
+        <geometry>
+          <cylinder radius="0.072" length="0.03" />
+        </geometry>
+      </collision>
+    </link>
+    <joint name="Drive${side}" type="continuous">
+      <parent link="Tibia" />
+      <child link="Drive${side}_link" />
+      <origin rpy="0 0 0" xyz="0.0 ${y} -0.264" />
+      <axis xyz="0 1 0" />
+    </joint>
+  </xacro:macro>
+
+  <xacro:virtual_drive_wheel side="L" y="0.155" />
+  <xacro:virtual_drive_wheel side="R" y="-0.155" />
+</robot>
diff --git a/pepper_robot_description/urdf/pepper_robot.gazebo b/pepper_robot_description/urdf/pepper_robot.gazebo
