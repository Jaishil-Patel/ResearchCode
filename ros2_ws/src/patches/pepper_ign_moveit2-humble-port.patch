diff --git a/pepper_robot_description/urdf/pepper_robot.gazebo b/pepper_robot_description/urdf/pepper_robot.gazebo
index 703778d..7abc517 100644
--- a/pepper_robot_description/urdf/pepper_robot.gazebo
+++ b/pepper_robot_description/urdf/pepper_robot.gazebo
@@ -49,6 +49,125 @@
   </xacro:macro>
 
 
+  <!--        -->
+  <!-- Sensor -->
+  <!--        -->
+  <!-- Depth camera, mirroring the CameraDepth_frame of pepper_sensors.xacro.
+       Attached to Head rather than to CameraDepth_frame: the sensor frames are massless links
+       behind fixed joints, which URDF->SDF conversion collapses into their parent, so a
+       <gazebo reference="CameraDepth_frame"> would not resolve. The pose below reproduces the
+       CameraDepth_frame offset exactly, so the sensor and the TF frame stay co-located.
+       Defaults approximate Pepper's ASUS-Xtion-class unit (Gomez et al. 2018). -->
+  <xacro:macro name="ign_depth_camera" params="
+   topic:=depth_camera
+   update_rate:=15
+   width:=320
+   height:=240
+   horizontal_fov:=1.0123
+   near_clip:=0.4
+   far_clip:=8.0
+">
+    <gazebo reference="Head">
+      <sensor name="camera_depth" type="depth_camera">
+        <topic>${topic}</topic>
+        <update_rate>${update_rate}</update_rate>
+        <always_on>true</always_on>
+        <visualize>false</visualize>
+        <!-- Matches CameraDepth_frame: parent Head, xyz 0.05138 0.039 0.1194, rpy 0 0 0 -->
+        <pose>0.05138 0.039 0.1194 0 0 0</pose>
+        <camera>
+          <horizontal_fov>${horizontal_fov}</horizontal_fov>
+          <image>
+            <width>${width}</width>
+            <height>${height}</height>
+            <format>R_FLOAT32</format>
+          </image>
+          <clip>
+            <near>${near_clip}</near>
+            <far>${far_clip}</far>
+          </clip>
+        </camera>
+      </sensor>
+    </gazebo>
+  </xacro:macro>
+
+
+  <!--        -->
+  <!-- Sensor -->
+  <!--        -->
+  <!-- Front surrounding laser. Placed at the SurroundingFrontLaser_device_frame position on Tibia
+       (0.0562 0 -0.0692), i.e. ~0.265 m above the ground plane.
+
+       Note on orientation: the hardware frame carries a 0.349066 rad (20 deg) downward pitch, and
+       the sibling "projected" frame sits at z=-0.334, which is exactly ground level; that frame
+       is NAOqi's ground projection of the readings, not a physical sensor location. Simulating a
+       pitched-down beam would return floor hits at short range, so the default here is a
+       horizontal scan, which is what NAOqi's projected laser API effectively exposes to a
+       navigation client. Override `pitch` to model the raw pitched beam instead. -->
+  <xacro:macro name="ign_front_lidar" params="
+   topic:=scan
+   update_rate:=10
+   samples:=15
+   min_angle:=-0.5236
+   max_angle:=0.5236
+   min_range:=0.1
+   max_range:=3.0
+   pitch:=0.0
+">
+    <gazebo reference="Tibia">
+      <sensor name="front_laser" type="gpu_lidar">
+        <topic>${topic}</topic>
+        <update_rate>${update_rate}</update_rate>
+        <always_on>true</always_on>
+        <visualize>true</visualize>
+        <pose>0.0562 0 -0.0692 0 ${pitch} 0</pose>
+        <lidar>
+          <scan>
+            <horizontal>
+              <samples>${samples}</samples>
+              <resolution>1</resolution>
+              <min_angle>${min_angle}</min_angle>
+              <max_angle>${max_angle}</max_angle>
+            </horizontal>
+            <vertical>
+              <samples>1</samples>
+              <resolution>1</resolution>
+              <min_angle>0</min_angle>
+              <max_angle>0</max_angle>
+            </vertical>
+          </scan>
+          <range>
+            <min>${min_range}</min>
+            <max>${max_range}</max>
+            <resolution>0.01</resolution>
+          </range>
+        </lidar>
+      </sensor>
+    </gazebo>
+  </xacro:macro>
+
+
+  <!--        -->
+  <!-- Sensor -->
+  <!--        -->
+  <!-- Torso IMU, mirroring ImuTorsoGyrometer_frame. Requires the world to load
+       ignition::gazebo::systems::Imu; the Sensors system alone does not drive IMUs. -->
+  <xacro:macro name="ign_imu" params="
+   topic:=imu
+   update_rate:=100
+">
+    <gazebo reference="torso">
+      <sensor name="imu_torso" type="imu">
+        <topic>${topic}</topic>
+        <update_rate>${update_rate}</update_rate>
+        <always_on>true</always_on>
+        <!-- Matches ImuTorsoGyrometer_frame: parent torso, xyz 0.00204 -0.03491 -0.00959 -->
+        <pose>0.00204 -0.03491 -0.00959 0 0 0</pose>
+      </sensor>
+    </gazebo>
+  </xacro:macro>
+
+
   <!--       -->
   <!-- Macro -->
   <!--       -->
