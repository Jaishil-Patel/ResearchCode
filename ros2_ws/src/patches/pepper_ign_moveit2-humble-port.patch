@@ -35,6 +35,66 @@
   <!--       -->
   <!-- Macro -->
   <!--       -->
+  <!-- Base locomotion: VelocityControl, NOT DiffDrive.
+       Pepper's three wheels sit 120 degrees apart (WheelFL yaw +1.075, WheelFR -1.075,
+       WheelB -pi); an omnidirectional base. DiffDrive assumes two wheels on one axle; driving
+       WheelFL/WheelFR as a diff pair makes them fight each other, and Fortress's DiffDrive has no
+       <back_joint>, so WheelB was dragged. Measured 30 Sep 2026 on room_standard: a 5 s forward
+       command at 0.3 m/s moved her 0.2 m BACKWARDS and left her leaning 22 degrees; random commands
+       tipped her past 40. VelocityControl applies the commanded (v, omega) to the base directly,
+       which is also how the real robot is driven (NAOqi ALMotion.move is a base velocity
+       command). The wheels are frictionless supports (see gazebo_misc_references). Same cmd_vel
+       topic as DiffDrive used, so bridge.launch.py and the RL env are unchanged. -->
+  <!-- Base locomotion actually used: DiffDrive on two virtual coaxial drive wheels. See
+       pepper_drive_wheels.xacro for the measurements behind this; the VelocityControl
+       macro below is superseded and kept only for the record. -->
+  <xacro:macro name="ign_virtual_diff_drive">
+    <gazebo>
+      <plugin filename="ignition-gazebo-diff-drive-system"
+        name="ignition::gazebo::systems::DiffDrive">
+        <left_joint>DriveL</left_joint>
+        <right_joint>DriveR</right_joint>
+        <wheel_separation>0.310</wheel_separation>
+        <wheel_radius>0.072</wheel_radius>
+        <topic>/model/pepper_robot/cmd_vel</topic>
+        <odom_topic>/model/pepper_robot/odometry</odom_topic>
+      </plugin>
+    </gazebo>
+    <gazebo reference="DriveL_link">
+      <mu1>1.0</mu1>
+      <mu2>1.0</mu2>
+    </gazebo>
+    <gazebo reference="DriveR_link">
+      <mu1>1.0</mu1>
+      <mu2>1.0</mu2>
+    </gazebo>
+  </xacro:macro>
+
+  <!-- SUPERSEDED (tried 30 Sep 2026, Pepper still tipped: it overwrites link velocity in the
+       link frame, so pitch becomes a climb gravity cannot correct). Not included. -->
+  <xacro:macro name="ign_base_velocity_control">
+    <gazebo>
+      <plugin filename="ignition-gazebo-velocity-control-system"
+        name="ignition::gazebo::systems::VelocityControl">
+        <!-- Command the WHEEL BASE. The model's canonical link, base_link, is the torso;
+             the 11.6 kg wheel base (Tibia) hangs below it through HipRoll, HipPitch and
+             KneePitch. Driving base_link pushed her at the shoulders: measured 30 Sep 2026,
+             pitch grew steadily from 0 to 70 deg over 6 s at 0.3 m/s. Link commands arrive on
+             /model/pepper_robot/link/Tibia/cmd_vel, which bridge.launch.py now targets. -->
+        <link_name>Tibia</link_name>
+      </plugin>
+      <plugin filename="ignition-gazebo-odometry-publisher-system"
+        name="ignition::gazebo::systems::OdometryPublisher">
+        <odom_frame>odom</odom_frame>
+        <robot_base_frame>base_link</robot_base_frame>
+        <odom_topic>/model/pepper_robot/odometry</odom_topic>
+        <dimensions>2</dimensions>
+      </plugin>
+    </gazebo>
+  </xacro:macro>
+
+
+  <!-- Superseded by ign_base_velocity_control (kept for reference / revert). -->
   <xacro:macro name="ign_diff_drive">
     <gazebo>
       <plugin filename="ignition-gazebo-diff-drive-system"
@@ -165,21 +225,53 @@
        the shared WORLD_TEMPLATE, so both branches get it from one place; adding it to one
